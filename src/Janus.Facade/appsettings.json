{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "System.Net.Http.HttpClient": "Warning" }
  },
  "AllowedHosts": "*",
  "Bridge": {
    "Capabilities": {
      "customers": { "Mode": "Legacy" },
      "schedules": { "Mode": "Legacy" },
      "arrears": { "Mode": "Legacy" }
    },
    "Legacy": {
      "BaseAddress": "http://localhost:5207",
      "TimeoutMs": 2000,
      "MaxRetries": 2,
      "BaseDelayMs": 100,
      "MaxDelayMs": 1000,
      "BreakerFailureThreshold": 5,
      "BreakerOpenSeconds": 30
    },
    "AllowRuntimeFlagChanges": false
  }
}
