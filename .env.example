# Janus configuration (environment variables override appsettings.json; "__" separates sections).
ASPNETCORE_ENVIRONMENT=Development
Bridge__Legacy__BaseAddress=http://localhost:5207
Bridge__Legacy__TimeoutMs=2000
Bridge__Legacy__MaxRetries=2
Bridge__Legacy__BreakerFailureThreshold=5
Bridge__Legacy__BreakerOpenSeconds=30
# Legacy | Shadow | New, per capability. Only customers has a new implementation in slice 1.
Bridge__Capabilities__customers__Mode=Legacy
# true only in Development: enables PUT/DELETE /bridge/flags/{capability}
Bridge__AllowRuntimeFlagChanges=false
